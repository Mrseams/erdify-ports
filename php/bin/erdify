#!/usr/bin/env php
<?php

declare(strict_types=1);

// Installed as a dependency (vendor/mrseams/erdify-php/bin) or run from a checkout.
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Mrseams\Erdify\Cli\Application())->run(array_slice($argv, 1)));
