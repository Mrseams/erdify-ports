@startuml Database ERD
!define Table(name,desc) class name as "desc" << (T,#FFAAAA) >>
!define primary_key(x) <b><color:#b8861b><&key></color> x</b>
!define foreign_key(x) <color:#aaaaaa><&key></color> x
!define column(x) <color:#efefef><&media-record></color> x

skinparam linetype ortho
skinparam roundcorner 5
skinparam class {
    BackgroundColor White
    ArrowColor Gray
    BorderColor Gray
}

' Entities

entity "author_out" as AuthorOut {
  column(id) : int
  column(name) : str
}

entity "book_out" as BookOut {
  column(id) : int
  column(title) : str
  column(author_id) : int
}

entity "timestamped_out" as TimestampedOut {
  column(created_at) : str
}

entity "review_out" as ReviewOut {
  column(created_at) : str
  column(id) : int
  column(rating) : int
}

entity "qualified_out" as QualifiedOut {
  column(id) : int
  column(note) : str
}

' Relationships


@enduml