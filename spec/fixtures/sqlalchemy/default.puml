@startuml Database ERD
!define Table(name,desc) class name as "desc" << (T,#FFAAAA) >>
!define primary_key(x) <b><color:#b8861b><&key></color> x</b>
!define foreign_key(x) <color:#aaaaaa><&key></color> x
!define column(x) <color:#efefef><&media-record></color> x

skinparam linetype ortho
skinparam roundcorner 5
skinparam class {
    BackgroundColor White
    ArrowColor Gray
    BorderColor Gray
}

' Enums

enum PostStatus << (E,#FFCC00) >> {
  DRAFT
  PUBLISHED
  ARCHIVED
}

' Entities

entity "author" as Author {
  column(created_at) : str
  column(updated_at) : str
  primary_key(id) : int
  column(name) : str
  column(email) : str
  column(bio) : str? = None
  column(is_active) : bool = True
}

entity "post" as Post {
  column(created_at) : str
  column(updated_at) : str
  primary_key(id) : int
  foreign_key(author_id) : int
  column(title) : str
  column(status) : PostStatus = DRAFT
  column(summary) : str? = None
}

entity "tag" as Tag {
  primary_key(id) : int
  column(label) : str
}

entity "post_tag_link" as PostTagLink << (L, #AAFFAA) link >> {
  primary_key(post_id) : int
  primary_key(tag_id) : int
}

' Relationships

Post }o--|| Author : "author_id"
Post ||--o{ PostTagLink : "post_id"
PostTagLink }o--|| Tag : "tag_id"

@enduml