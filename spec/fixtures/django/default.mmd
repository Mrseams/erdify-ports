erDiagram
    Author {
        int id PK
        datetime created_at
        datetime updated_at
        str name
        str bio
    }
    Profile {
        int id PK
        str website
        JSONField preferences
    }
    Tag {
        int id PK
        str label
    }
    Post {
        int id PK
        datetime created_at
        datetime updated_at
        str title
        int author_id FK
        Status status
        Priority priority
    }
    Group {
        int id PK
        str name
    }
    Membership {
        int id PK
        int author_id FK
        int group_id FK
        str role
    }
    Category {
        int id PK
        str name
        int parent_id FK "nullable"
    }
    Priority {
        enum LOW
        enum HIGH
    }
    Status {
        enum DRAFT
        enum PUBLISHED
    }
    Post }o--|| Author : "author_id"
    Membership }o--|| Author : "author_id"
    Membership }o--|| Group : "group_id"
    Category }o--|| Category : "parent_id"
    Profile ||--|| Author : "author"
    Post }o--o{ Tag : "tags"